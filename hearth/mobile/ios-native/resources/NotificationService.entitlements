<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The notification extension reads the app's server from the App Group and its push keys from the Keychain group
     it shares with the app (the first keychain-access-groups entry is the default one DeviceKeys uses). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.hearth.mobile</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)group.app.hearth.mobile</string>
	</array>
</dict>
</plist>
